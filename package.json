{
  "name": "timealign",
  "productName": "TimeAlign",
  "version": "1.1.0",
  "description": "Speaker time alignment (dual-FFT transfer function, Smaart-style) for Dante Virtual Soundcard / USB interfaces",
  "main": "main.js",
  "author": "fivealarmtech",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac dmg zip --arm64 --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.fivealarmtech.timealign",
    "productName": "TimeAlign",
    "files": ["main.js", "app/**"],
    "afterPack": "build/afterPack.js",
    "mac": {
      "category": "public.app-category.music",
      "icon": "build/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "TimeAlign listens to your measurement microphone to time-align speakers."
      }
    },
    "dmg": { "title": "TimeAlign" }
  }
}
